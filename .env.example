# Copy to .env and fill in. Never commit .env.

# Anthropic API key, used by LiteLLM for anthropic/* models.
ANTHROPIC_API_KEY=

# Where runs and artifacts are stored: "local" (.data/) or "gcs".
STORAGE=local
# BUCKET=

# Optional per-role model overrides (LiteLLM model strings).
# LEAD_MODEL=anthropic/claude-opus-5-5
# RESEARCHER_MODEL=anthropic/claude-opus-5-5
# WRITER_MODEL=anthropic/claude-opus-5-5
# HUMANIZER_MODEL=anthropic/claude-opus-5-5
# Example of moving researchers onto Gemini (uses gcloud credentials, no key):
# RESEARCHER_MODEL=vertex_ai/gemini-3.5-flash-lite
